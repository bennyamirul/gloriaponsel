// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  super_admin
  admin
}

enum MovementType {
  in
  out
  adjustment
}

enum ReferenceType {
  purchase
  sale
  manual
}

enum PaymentMethod {
  cash
  transfer
  edc
  qris
}

enum SaleStatus {
  completed
  cancelled
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(admin)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  stockMovements StockMovement[]
  purchases      Purchase[]
  sales          Sale[]

  @@map("users")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  products    Product[]

  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  logoUrl   String?   @map("logo_url")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("brands")
}

model Supplier {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  phone     String
  address   String?
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  purchases Purchase[]

  @@map("suppliers")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  sales     Sale[]

  @@map("customers")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  brandId        String?  @map("brand_id") @db.Uuid
  categoryId     String?  @map("category_id") @db.Uuid
  brandName      String?  @map("brand_name")
  categoryName   String?  @map("category_name")
  sku            String   @unique
  imei           String?  @unique
  productType    String   @default("phone") @map("product_type") // 'phone' | 'accessory'
  capacity       String?
  color          String?
  completeness   String?
  retailSupplier String?  @map("retail_supplier")
  status         String   @default("available") // 'available' | 'sold'
  entryDate      DateTime @default(now()) @map("entry_date")
  variant        String?
  purchasePrice  Decimal  @map("purchase_price") @db.Decimal(15, 2)
  sellingPrice   Decimal  @map("selling_price") @db.Decimal(15, 2)
  stock          Int      @default(0)
  minStock       Int      @default(5) @map("min_stock")
  imageUrl       String?  @map("image_url")
  description    String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  brand          Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]

  @@index([brandId])
  @@index([categoryId])
  @@index([isActive])
  @@index([stock])
  @@index([imei])
  @@index([productType])
  @@index([status])
  @@map("products")
}

model StockMovement {
  id            String        @id @default(uuid()) @db.Uuid
  productId     String        @map("product_id") @db.Uuid
  type          MovementType
  quantity      Int // positif untuk in, negatif untuk out/adjustment turun
  referenceType ReferenceType @map("reference_type")
  referenceId   String?       @map("reference_id")
  note          String?       @db.Text
  createdById   String        @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  creator User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([createdAt])
  @@index([type])
  @@map("stock_movements")
}

model Purchase {
  id           String   @id @default(uuid()) @db.Uuid
  invoiceNo    String   @map("invoice_no")
  supplierId   String   @map("supplier_id") @db.Uuid
  purchaseDate DateTime @default(now()) @map("purchase_date")
  createdById  String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  creator  User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items    PurchaseItem[]

  @@index([supplierId])
  @@index([createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id         String  @id @default(uuid()) @db.Uuid
  purchaseId String  @map("purchase_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  qty        Int
  unitCost   Decimal @map("unit_cost") @db.Decimal(15, 2)
  subtotal   Decimal @db.Decimal(15, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model Sale {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceNo      String        @unique @map("invoice_no")
  customerId     String?       @map("customer_id") @db.Uuid
  subtotal       Decimal       @db.Decimal(15, 2)
  discount       Decimal       @default(0) @db.Decimal(15, 2)
  additionalFee  Decimal       @default(0) @map("additional_fee") @db.Decimal(15, 2)
  warrantyDays   Int           @default(0) @map("warranty_days")
  warrantyExpiry DateTime?     @map("warranty_expiry")
  total          Decimal       @db.Decimal(15, 2)
  paymentMethod  PaymentMethod @map("payment_method")
  status         SaleStatus    @default(completed)
  cashierId      String        @map("cashier_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashier  User       @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  items    SaleItem[]

  @@index([createdAt])
  @@index([invoiceNo])
  @@index([status])
  @@index([cashierId])
  @@map("sales")
}

model SaleItem {
  id             String    @id @default(uuid()) @db.Uuid
  saleId         String    @map("sale_id") @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  qty            Int
  unitPrice      Decimal   @map("unit_price") @db.Decimal(15, 2)
  unitCost       Decimal   @map("unit_cost") @db.Decimal(15, 2) // snapshot harga modal saat transaksi
  subtotal       Decimal   @db.Decimal(15, 2)
  warrantyDays   Int       @default(0) @map("warranty_days")
  warrantyExpiry DateTime? @map("warranty_expiry")
  isReturned     Boolean   @default(false) @map("is_returned")
  returnReason   String?   @map("return_reason")
  returnedAt     DateTime? @map("returned_at")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@index([isReturned])
  @@map("sale_items")
}

model StoreSetting {
  id              String   @id @default(uuid()) @db.Uuid
  storeName       String   @default("Gloria Ponsel") @map("store_name")
  phone           String?  @default("081234567890")
  address         String?  @default("Jl. Telekomunikasi No. 1, Jakarta")
  logoUrl         String?  @map("logo_url")
  receiptFooter   String?  @default("Terima kasih atas kunjungan Anda!\nBarang yang sudah dibeli tidak dapat ditukar.") @map("receipt_footer")
  defaultMinStock Int      @default(5) @map("default_min_stock")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

